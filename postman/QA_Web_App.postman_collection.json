{
  "info": {
    "_postman_id": "7d282c27-d500-4f93-bb6a-qaautomation",
    "name": "QA Web App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual and regression API checks for the QA automation demo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Health status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"qa@example.com\", \"password\": \"Password123\"}"
        },
        "url": "{{baseUrl}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Login successful', () => pm.expect(pm.response.json().message).to.eql('Login successful'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"qa@example.com\", \"password\": \"wrong\"}"
        },
        "url": "{{baseUrl}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - Minimum Age Boundary",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"tester\", \"age\": 18}"
        },
        "url": "{{baseUrl}}/api/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Minimum age accepted', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - Maximum Age Boundary",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"tester\", \"age\": 65}"
        },
        "url": "{{baseUrl}}/api/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Maximum age accepted', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - Under Age Negative Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"tester\", \"age\": 17}"
        },
        "url": "{{baseUrl}}/api/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Under age is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - Invalid Username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"ab\", \"age\": 30}"
        },
        "url": "{{baseUrl}}/api/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Short username is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Items",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/items?q=mouse",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ],
          "query": [
            {
              "key": "q",
              "value": "mouse"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Search succeeds', () => pm.response.to.have.status(200));",
              "pm.test('Mouse is returned', () => pm.expect(pm.response.json().items[0].name).to.eql('Mouse'));"
            ]
          }
        }
      ]
    }
  ]
}